# Copy this file to .env. Never commit real credentials.
PIXELVAULT_SECRET_KEY=
PIXELVAULT_DEBUG=1
PIXELVAULT_ALLOWED_HOSTS=127.0.0.1,localhost
PIXELVAULT_TIME_ZONE=UTC
# PIXELVAULT_DB_PATH=C:\path\to\pixelvault.sqlite3
# PIXELVAULT_CSRF_TRUSTED_ORIGINS=https://pixelvault.example.com
# PIXELVAULT_SECURE_COOKIES=1
# PIXELVAULT_SSL_REDIRECT=1

NVIDIA_API_KEY=
PET_AGENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
PET_AGENT_TIMEOUT_SECONDS=60
PET_AGENT_RETRIES=1
PET_AGENT_MAX_TOKENS=700
PET_AGENT_STREAM=1
# Keep tool calls concise and leave the response budget for the answer.
PET_AGENT_THINKING=0
PET_EMBED_MODEL=nvidia/nemotron-3-embed-1b

REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_ENGINE=sqlite
